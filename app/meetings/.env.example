# Entra ID app registration: Web platform, redirect URI below, a client secret,
# delegated Graph permissions OnlineMeetings.Read, OnlineMeetingTranscript.Read.All
# (admin consent), and Calendars.Read if you want the join link auto-filled.
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/auth/callback
MS_SCOPES=OnlineMeetings.Read,OnlineMeetingTranscript.Read.All,Calendars.Read

# Long random string for the session cookie
SESSION_SECRET=
# Fernet key for the token cache:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
SUMMARY_CHUNK_CHARS=400000
SUMMARY_MAX_TOKENS=16000
MEETINGS_DB=meetings.sqlite3
